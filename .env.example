# Copy this file to .env for a laptop. On Railway or a server, set these in the host's env screen instead.

# PostgreSQL connection string. Railway, Supabase, and Neon all give you one.
# Example: postgresql://USER:PASSWORD@HOST:5432/codebharat
DATABASE_URL="postgresql://codebharat:codebharat@127.0.0.1:5432/codebharat"

# A long random string. Anyone with this can forge login cookies. Change it.
SESSION_SECRET="put-a-long-random-string-here-at-least-32-characters"

# local = files on this computer (only for a trial). s3 = Cloudflare R2, AWS, or MinIO.
STORAGE_DRIVER="s3"

# Where the app server reaches the file store. For R2 this looks like
# https://ACCOUNT_ID.r2.cloudflarestorage.com
# For MinIO on the same Docker network: http://minio:9000
S3_ENDPOINT="http://127.0.0.1:9000"

# Where the browser uploads. Often the same as S3_ENDPOINT.
# For MinIO on your server, use http://YOUR_SERVER_IP:9000
S3_PUBLIC_ENDPOINT="http://127.0.0.1:9000"

# R2 uses auto. AWS uses a region like ap-south-1. MinIO can use us-east-1.
S3_REGION="auto"

# Bucket name you create in R2 or MinIO.
S3_BUCKET="codebharat"

# API token from the storage provider. Not your personal password, except on MinIO.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# true for MinIO, R2, and Supabase Storage. false for normal AWS S3.
S3_FORCE_PATH_STYLE="true"

# Only used when STORAGE_DRIVER=local.
UPLOAD_DIR="./data/uploads"

# Largest single file, in megabytes. Default 25.
FILE_SIZE_LIMIT_MB="25"

# How much one squad may store, in megabytes. Default 500.
TEAM_QUOTA_MB="500"

# The app listens on this port, on every network interface.
PORT="4317"
HOST="0.0.0.0"

# Words on the public board and the sign-in page.
EVENT_NAME="CodeBharat 2026"
EVENT_EDITION="2nd Edition"
EVENT_VENUE="IIIT Dharwad"
EVENT_DATES="3–4 December 2026"
EVENT_THEME="From Code to Concrete Innovation"
EVENT_LOGO_URL=""

# true shows the sample logins on the sign-in page. Leave false for the real event.
DEMO_HINTS="false"

# Leave empty. The app marks cookies Secure when the proxy says the site is HTTPS.
# Set true only if your proxy does not send X-Forwarded-Proto.
# COOKIE_SECURE="true"

# Extra public hostnames, comma-separated, if the proxy Host header is not the public name.
# ALLOWED_ORIGINS="live.codebharat.sasa.engineer"

# Used only by npm run seed:production. The organizer must change this at first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
