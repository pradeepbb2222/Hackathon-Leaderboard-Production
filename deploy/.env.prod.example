# Copy this file to deploy/.env.prod and change the passwords.
# docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml up -d

POSTGRES_USER=codebharat
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=codebharat

MINIO_ROOT_USER=codebharat
MINIO_ROOT_PASSWORD=change-this-file-password

# Long random string. Do not use the words "change-me".
SESSION_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# First organizer password. They must change it at first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# http://  means no certificate (campus network or a test).
# A real name, such as leaderboard.iiitdwd.ac.in, turns on HTTPS.
SITE_ADDRESS=http://

# Where the browser sends files. Use the server's address and port 9000.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=codebharat

# Set to true only for a dress rehearsal.
DEMO_HINTS=false
COOKIE_SECURE=false
