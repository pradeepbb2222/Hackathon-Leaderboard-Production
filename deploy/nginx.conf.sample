# Give this to the college IT team if they already run Nginx.
# Replace leaderboard.iiitdwd.ac.in with the real name.
# The app listens on port 4317 on the same machine.

server {
    listen 80;
    server_name leaderboard.iiitdwd.ac.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name leaderboard.iiitdwd.ac.in;

    # IT already has these certificate files.
    ssl_certificate     /etc/ssl/certs/leaderboard.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/leaderboard.key;

    client_max_body_size 30m;

    location /api/live/stream {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location / {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}
